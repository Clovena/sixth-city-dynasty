---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { getEntry, render, getCollection } from 'astro:content';
import { loadFranchises, franchiseForYear, logoPath, primaryColor as getPrimaryColor } from '../../lib/franchise-identity';
import { toRoman, formatPoints } from '../../lib/format';
import { buildSlug, isPlayablePostseasonGame, loadChampionshipMatchups } from '../../lib/game-utils';

// ── Static paths: active franchises only ──────────────────────────────────
export async function getStaticPaths() {
  const { supabase: sb } = await import('../../lib/supabase');
  const { data: rows } = await sb
    .schema('scdfl')
    .from('franchises')
    .select('abbr')
    .is('to', null);
  return (rows ?? []).map(f => ({ params: { abbr: f.abbr } }));
}

const { abbr } = Astro.params;

// ── Fetch active franchise by abbr ────────────────────────────────────────
const { data: franchise, error: fErr } = await supabase
  .schema('scdfl')
  .from('franchises')
  .select('id, sleeper_id, abbr, name, owner, conf, colors, "from", "to"')
  .eq('abbr', abbr)
  .is('to', null)
  .single();

if (fErr || !franchise) {
  return Astro.redirect('/franchises');
}

// ── Fetch all identities for this franchise (historical + current) ────────
const { data: allIdentities, error: idErr } = await supabase
  .schema('scdfl')
  .from('franchises')
  .select('abbr, name, owner, "from", "to"')
  .eq('sleeper_id', franchise.sleeper_id)
  .order('from');

if (idErr) throw new Error(`Identities query failed: ${idErr.message}`);

// All historical abbreviations for this franchise
const allAbbrs: string[] = allIdentities.map(f => f.abbr);

// "Founded" = earliest year this owner participated under this sleeper_id
const ownerIdentities = allIdentities.filter(f => f.owner === franchise.owner);
const founded = ownerIdentities.length > 0
  ? Math.min(...ownerIdentities.map(f => f.from))
  : franchise.from;

// Identity eras collapsed by name. A pure abbr change (brand refresh with no
// rename) creates a second `franchises` row, but reads as the same identity to
// an end user — so consecutive eras sharing a name merge into one entry.
type IdentityGroup = { name: string; from: number; to: number | null };
const identityGroups = allIdentities.reduce<IdentityGroup[]>((groups, era) => {
  const prev = groups[groups.length - 1];
  if (prev && prev.name === era.name.trim()) {
    // Extend the run; `to: null` (current era) always wins.
    prev.to = era.to === null ? null : Math.max(prev.to ?? era.to, era.to);
  } else {
    groups.push({ name: era.name.trim(), from: era.from, to: era.to });
  }
  return groups;
}, []);

// Only a genuine rename counts as a rebrand worth listing.
const historicalIdentities = identityGroups.filter(g => g.to !== null);
const currentIdentity = identityGroups[identityGroups.length - 1];
const hasRebrands = historicalIdentities.length > 0;

// Adoption: owner didn't start from year 2021
const isAdopted = founded !== 2021;

// Get franchise notes markdown from content collection
const notesEntry = await getEntry('franchises', abbr.toLowerCase());
let FranchiseContent: any = null;
if (notesEntry) {
  const { Content } = await render(notesEntry);
  FranchiseContent = Content;
}

const primaryColor = getPrimaryColor(franchise.colors);
const secondaryColor = franchise.colors[1] ?? franchise.colors[0];
const confColor = franchise.conf === 'SCC' ? 'var(--color-scc)' : 'var(--color-hcc)';

// ── Fetch seasons (for conf champions) ────────────────────────────────────
const { data: seasonRows, error: sErr } = await supabase
  .schema('scdfl')
  .from('seasons')
  .select('year, scc_champion, hcc_champion')
  .order('year');

if (sErr) throw new Error(`Seasons query failed: ${sErr.message}`);

// ── Fetch championship matchups (week 17, game_type = 1, already played) ──
const playedChampMatchups = await loadChampionshipMatchups();

// Dynasty Bowl appearances for this franchise
const sleeperId = parseInt(franchise.sleeper_id);
const myChampMatchups = playedChampMatchups.filter(
  m => m.roster_id_a === sleeperId || m.roster_id_b === sleeperId
);

// ── Fetch all franchise identities (for year-appropriate display) ─────────
const allFranchiseRows = await loadFranchises();

// Build dynasty bowl appearance data
type DynastyBowlAppearance = {
  year: number;
  won: boolean;
  label: string;
  opponentAbbr: string;
  opponentSleeperId: string;
};

const dynastyBowlAppearances: DynastyBowlAppearance[] = [];
for (const m of myChampMatchups) {
  const aWins = m.score_a > m.score_b;
  const iAmA = m.roster_id_a === sleeperId;
  const won = (iAmA && aWins) || (!iAmA && !aWins);
  const oppRosterId = iAmA ? m.roster_id_b : m.roster_id_a;
  const oppSleeperId = String(oppRosterId);
  const oppIdentity = franchiseForYear(allFranchiseRows, oppSleeperId, m.year);
  dynastyBowlAppearances.push({
    year: m.year,
    won,
    label: `Dynasty Bowl ${toRoman(m.year - 2020)}`,
    opponentAbbr: oppIdentity?.abbr ?? 'UNK',
    opponentSleeperId: oppSleeperId,
  });
}
dynastyBowlAppearances.sort((a, b) => a.year - b.year);

const championships = dynastyBowlAppearances.filter(a => a.won);
const runnerUps = dynastyBowlAppearances.filter(a => !a.won);

// Conference championship history
const confChamps = (seasonRows ?? []).filter(s => {
  const confChampAbbr = franchise.conf === 'SCC' ? s.scc_champion : s.hcc_champion;
  return allAbbrs.includes(confChampAbbr);
});

// ── Fetch spotlight games for this franchise ──────────────────────────────
// Determine current year from max year in spotlight_game_years
const { data: maxYearRow } = await supabase
  .schema('scdfl')
  .from('spotlight_game_years')
  .select('year')
  .order('year', { ascending: false })
  .limit(1);

const spotlightYear = maxYearRow?.[0]?.year ?? 2026;

const { data: spotlightRows, error: spErr } = await supabase
  .schema('scdfl')
  .from('spotlight_game_years')
  .select('slug, spotlight_games(slug, name, type, team_a, team_b)')
  .eq('year', spotlightYear);

if (spErr) throw new Error(`Spotlight games query failed: ${spErr.message}`);

type SpotlightGame = { slug: string; name: string; type: string; team_a: string; team_b: string };
const spotlightGames: SpotlightGame[] = (spotlightRows ?? []).map(r => {
  const g = r.spotlight_games as unknown as SpotlightGame;
  return { slug: g.slug, name: g.name, type: g.type, team_a: g.team_a, team_b: g.team_b };
});

const myBowlGames = spotlightGames.filter(bg => bg.type === 'bowl-game' && (bg.team_a === abbr || bg.team_b === abbr));
const myRivalryGames = spotlightGames.filter(rg => rg.type === 'rivalry' && (rg.team_a === abbr || rg.team_b === abbr));

function getSpotlightOpponent(g: SpotlightGame) {
  return g.team_a === abbr ? g.team_b : g.team_a;
}
function getOpponentFranchise(oppAbbr: string) {
  return allFranchiseRows.find(f => f.abbr === oppAbbr);
}

// ── Fetch results for this franchise ──────────────────────────────────────
const { data: resultRows, error: rErr } = await supabase
  .schema('scdfl')
  .from('results')
  .select('year, wins, losses, points_for, points_against, playoff, finish')
  .eq('sleeper_id', franchise.sleeper_id)
  .order('year');

if (rErr) throw new Error(`Results query failed: ${rErr.message}`);

const franchiseResults = resultRows ?? [];

// Season record totals
const totalWins = franchiseResults.reduce((sum, r) => sum + r.wins, 0);
const totalLosses = franchiseResults.reduce((sum, r) => sum + r.losses, 0);
const totalPF = franchiseResults.reduce((sum, r) => sum + r.points_for, 0);
const totalPA = franchiseResults.reduce((sum, r) => sum + r.points_against, 0);

// ── Fetch matchups for this franchise (all years, for Games section) ──────
const { data: matchupRows, error: mErr } = await supabase
  .schema('scdfl')
  .from('matchups')
  .select('year, week, matchup_id, game_type, roster_id_a, roster_id_b, score_a, score_b')
  .or(`roster_id_a.eq.${sleeperId},roster_id_b.eq.${sleeperId}`)
  .limit(1000);

if (mErr) throw new Error(`Matchups query failed: ${mErr.message}`);

// Build matchups data structure for client JS: { year: { week: [entry, ...] } }
type ClientMatchupEntry = { roster_id: number; matchup_id: number; score: number };
const matchupsData: Record<string, Record<string, ClientMatchupEntry[]>> = {};

for (const m of matchupRows ?? []) {
  if (!m.matchup_id) continue;

  // Skip not-yet-started postseason games. Sleeper seeds the playoff/consolation
  // bracket with placeholder (random) opponents before the postseason begins;
  // these show up as 0–0 and don't reflect the real slate, so exclude them.
  // Regular-season games (game_type 0) are always kept, even at 0–0.
  if (!isPlayablePostseasonGame(m.game_type, m.score_a, m.score_b)) continue;

  const yr = String(m.year);
  const wk = String(m.week);
  if (!matchupsData[yr]) matchupsData[yr] = {};
  if (!matchupsData[yr][wk]) matchupsData[yr][wk] = [];

  // Add both sides as separate entries (client JS expects this format)
  matchupsData[yr][wk].push(
    { roster_id: m.roster_id_a, matchup_id: m.matchup_id, score: m.score_a ?? 0 },
    { roster_id: m.roster_id_b, matchup_id: m.matchup_id, score: m.score_b ?? 0 },
  );
}

// ── Recap slug array ─────────────────────────────────────────────────────────
const allRecaps = await getCollection('recaps');
const recapSlugsArr: string[] = allRecaps.map(r => r.id);

// ── Franchise identity map for client JS (sleeper_id → identity array) ─────
type FranchiseIdentity = { abbr: string; name: string; from: number; to: number | null };
const franchiseIdentities: Record<string, FranchiseIdentity[]> = {};
for (const f of allFranchiseRows) {
  const key = f.sleeper_id;
  if (!franchiseIdentities[key]) franchiseIdentities[key] = [];
  franchiseIdentities[key].push({ abbr: f.abbr, name: f.name, from: f.from, to: f.to });
}

// ── Dynasty Bowl lookup for client JS ─────────────────────────────────────
const dynastyBowls: Record<string, { winnerSleeperId: string; loserSleeperId: string; label: string }> = {};
for (const m of playedChampMatchups) {
  const aWins = m.score_a > m.score_b;
  dynastyBowls[String(m.year)] = {
    winnerSleeperId: String(aWins ? m.roster_id_a : m.roster_id_b),
    loserSleeperId: String(aWins ? m.roster_id_b : m.roster_id_a),
    label: `Dynasty Bowl ${toRoman(m.year - 2020)}`,
  };
}

// ── Determine available seasons for year selector ─────────────────────────
const availableYears = Object.keys(matchupsData).map(Number).sort((a, b) => b - a);
const defaultSeasonYear = availableYears[0] ?? (seasonRows?.[seasonRows.length - 1]?.year ?? 2021);

// ── Game-by-game performance chart (Widget A) ─────────────────────────────
// One row per regular-season game this franchise (all identity eras) has played.
// roster_id in matchups equals the stable sleeper_id, so predecessor games are
// already included in matchupRows; franchiseForYear resolves the era's real abbr.
type GamePerf = {
  year: number;
  week: number;
  pf: number;
  pa: number;
  diff: number;
  result: 'W' | 'L' | 'T';
  myAbbr: string;
  oppAbbr: string;
  oppName: string;
};

const gamePerf: GamePerf[] = [];
for (const m of matchupRows ?? []) {
  if (m.game_type !== 0) continue;               // regular season only
  const sa = m.score_a ?? 0;
  const sb = m.score_b ?? 0;
  if (sa === 0 && sb === 0) continue;            // drop unplayed placeholder weeks

  const iAmA = m.roster_id_a === sleeperId;
  const pf = iAmA ? sa : sb;
  const pa = iAmA ? sb : sa;
  const oppRid = iAmA ? m.roster_id_b : m.roster_id_a;
  const diff = pf - pa;
  const result: 'W' | 'L' | 'T' = pf > pa ? 'W' : pf < pa ? 'L' : 'T';

  const myId = franchiseForYear(allFranchiseRows, franchise.sleeper_id, m.year);
  const oppId = franchiseForYear(allFranchiseRows, String(oppRid), m.year);

  gamePerf.push({
    year: m.year,
    week: m.week,
    pf, pa, diff, result,
    myAbbr: myId?.abbr ?? franchise.abbr,
    oppAbbr: oppId?.abbr ?? 'UNK',
    oppName: oppId?.name ?? 'Unknown',
  });
}
gamePerf.sort((a, b) => a.year - b.year || a.week - b.week);

const perfSeasons = [...new Set(gamePerf.map(g => g.year))].sort((a, b) => a - b);
const perfDefaultSeason = perfSeasons.length > 0 ? perfSeasons[perfSeasons.length - 1] : defaultSeasonYear;
---

<Layout
  title={franchise.name}
  description={`Franchise profile for ${franchise.name} (${franchise.abbr}), owned by ${franchise.owner}. ${franchise.conf} — Sixth City Dynasty Football League.`}
>

  <!-- ══ DOSSIER HEADER ══════════════════════════════════════════════════
       A full-bleed band tinted with the club's own primary, so each franchise
       page opens in its own colours rather than in a generic card. ───────── -->
  <header class="dossier" style={`--primary: ${primaryColor}; --secondary: ${secondaryColor};`}>
    <div class="wrap">
      <a href="/franchises" class="dossier-back">&#8592;&nbsp; All Franchises</a>

      <div class="dossier-grid">
        <img
          class="dossier-crest"
          src={logoPath(abbr)}
          alt={`${franchise.name} logo`}
          width="120"
          height="120"
          onerror="this.style.display='none'"
        />

        <div class="dossier-identity">
          <p class="dossier-slug">
            <span class="dossier-abbr">{franchise.abbr}</span>
            <span class={`label-badge badge-${franchise.conf.toLowerCase()}`}>{franchise.conf}</span>
            <span class="dossier-since">Est. {founded}</span>
          </p>
          <h1 class="dossier-name">{franchise.name}</h1>
          <p class="dossier-owner">
            Operated by <strong>{franchise.owner}</strong>
            <span class="dossier-swatches" aria-hidden="true">
              {franchise.colors.map((c: string) => <span style={`background-color: ${c};`} title={c}></span>)}
            </span>
          </p>
        </div>

        <dl class="dossier-vitals">
          <div>
            <dt>All-time</dt>
            <dd>{totalWins}&ndash;{totalLosses}</dd>
          </div>
          <div>
            <dt>Pct</dt>
            <dd>{(totalWins + totalLosses === 0 ? 0 : totalWins / (totalWins + totalLosses)).toFixed(3).replace(/^0/, '')}</dd>
          </div>
          <div>
            <dt>Seasons</dt>
            <dd>{franchiseResults.length}</dd>
          </div>
          <div>
            <dt>Points for</dt>
            <dd>{Math.round(totalPF).toLocaleString('en-US')}</dd>
          </div>
        </dl>
      </div>

      {(championships.length > 0 || runnerUps.length > 0 || confChamps.length > 0) && (
        <ul class="dossier-honors">
          {championships.map(c => (
            <li><span class="mark mark-title">&#11042;</span> Dynasty Bowl, {c.year}</li>
          ))}
          {runnerUps.map(r => (
            <li><span class="mark mark-runner">&#11041;</span> Runner-up, {r.year}</li>
          ))}
          {confChamps.map(sc => (
            <li><span class={`mark mark-conf-${franchise.conf.toLowerCase()}`}>&#9650;</span> {franchise.conf} champion, {sc.year}</li>
          ))}
        </ul>
      )}
    </div>
  </header>

  <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">

    <div class="franchise-layout-grid" style="display: grid; grid-template-columns: 1fr 300px; gap: 3rem; margin-top: 3rem; align-items: start;">

      <!-- Main column -->
      <div class="franchise-main-col">

        <!-- Franchise notes markdown -->
        {FranchiseContent && (
          <div style="margin-bottom: 2rem;">
            <h2 class="sect-head">Franchise Notes</h2>
            <div style="font-size: 0.9rem; color: var(--color-text-secondary); text-align: justify; line-height: 1.7;">
              <FranchiseContent />
            </div>
          </div>
        )}

        <!-- Rebrand history -->
        {hasRebrands && (
          <div style="background-color: var(--color-surface); border: 1px solid var(--color-border); padding: 1.25rem 1.5rem; margin-bottom: 2rem;">
            <p class="section-label" style="margin-bottom: 0.6rem;">Identity History</p>
            <div style="display: flex; flex-direction: column; gap: 0.3rem;">
              {historicalIdentities.map(identity => {
                const yearRange = identity.to && identity.to > identity.from
                  ? `${identity.from}–${identity.to}`
                  : String(identity.from);
                return (
                  <div style="display: flex; align-items: baseline; gap: 0.75rem;">
                    <span style="font-size: 0.75rem; color: var(--color-text-muted); min-width: 60px;">
                      {yearRange}
                    </span>
                    <span style="font-size: 0.875rem; color: var(--color-text-secondary);">{identity.name}</span>
                  </div>
                );
              })}
              <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 0.1rem; padding-top: 0.3rem; border-top: 1px solid var(--color-border);">
                <span style="font-size: 0.75rem; color: var(--color-text-muted); min-width: 60px;">
                  {currentIdentity.from}–
                </span>
                <span style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-primary);">{currentIdentity.name} <span style="font-weight: 400; color: var(--color-text-muted); font-size: 0.8rem;">(current)</span></span>
              </div>
            </div>
          </div>
        )}

        <!-- Season record -->
        <div>
          <h2 class="sect-head">Season Record</h2>
          <div class="season-record-wrap" style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Season</th>
                  {isAdopted && <th></th>}
                  <th>W</th>
                  <th>L</th>
                  <th class="col-hide-mobile" style="text-align: right;">PF</th>
                  <th class="col-hide-mobile" style="text-align: right;">PA</th>
                  <th>Result</th>
                </tr>
              </thead>
              <tbody>
                {franchiseResults.map(row => {
                  const seasonNotStarted = row.points_for === 0 && row.points_against === 0;
                  const isChamp = row.finish === 'Champion';
                  const isRunnerUp = row.finish === 'Runner-up';
                  const isPlayoff = row.playoff && !isChamp && !isRunnerUp;
                  const resultStyle = isChamp
                    ? 'color: var(--color-gold); font-weight: 600;'
                    : isRunnerUp
                    ? 'color: var(--color-text-secondary); font-weight: 600;'
                    : isPlayoff
                    ? 'color: var(--color-text-secondary);'
                    : 'color: var(--color-text-muted);';
                  return (
                  <tr>
                    <td style="font-weight: 600;">{row.year}</td>
                    {isAdopted && (
                      <td style="padding: 0.25rem 0.5rem; text-align: center;">
                        <img
                          src={logoPath(franchiseForYear(allFranchiseRows, franchise.sleeper_id, row.year)?.abbr ?? abbr)}
                          alt=""
                          width="24"
                          height="24"
                          style="object-fit: contain; vertical-align: middle;"
                          onerror="this.style.display='none'"
                        />
                      </td>
                    )}
                    {seasonNotStarted ? (
                      <>
                        <td colspan="4" class="season-not-started-desktop" style="color: var(--color-text-muted); text-align: center;">Season not yet started.</td>
                        <td colspan="2" class="season-not-started-mobile" style="color: var(--color-text-muted); text-align: center; display: none;">Season not started.</td>
                      </>
                    ) : (
                      <>
                        <td>{row.wins}</td>
                        <td>{row.losses}</td>
                        <td class="col-hide-mobile" style="text-align: right; font-variant-numeric: tabular-nums;">{formatPoints(row.points_for)}</td>
                        <td class="col-hide-mobile" style="text-align: right; font-variant-numeric: tabular-nums;">{formatPoints(row.points_against)}</td>
                      </>
                    )}
                    <td style={resultStyle}>{seasonNotStarted ? '—' : row.finish}</td>
                  </tr>
                  );
                })}
                {franchiseResults.length > 0 && (
                  <tr style={`background-color: ${primaryColor}33; border-left: 4px solid ${primaryColor};`}>
                    <td style="font-weight: 700;">Total</td>
                    {isAdopted && <td></td>}
                    <td style="font-weight: 700;">{totalWins}</td>
                    <td style="font-weight: 700;">{totalLosses}</td>
                    <td class="col-hide-mobile" style="text-align: right; font-variant-numeric: tabular-nums; font-weight: 700;">{totalPF.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td class="col-hide-mobile" style="text-align: right; font-variant-numeric: tabular-nums; font-weight: 700;">{totalPA.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td></td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Margin column. Ruled sections rather than a stack of five identical
           boxes; the franchise-facts panel is gone because the dossier header
           above already carries every number it held. -->
      <aside class="dossier-margin">

        {dynastyBowlAppearances.length > 0 && (
          <section class="margin-block">
            <h2 class="margin-head">Dynasty Bowl History</h2>
            <ul class="margin-list">
              {dynastyBowlAppearances.map(a => {
                const oppDisplay = franchiseForYear(allFranchiseRows, a.opponentSleeperId, a.year);
                const myDisplay = franchiseForYear(allFranchiseRows, franchise.sleeper_id, a.year);
                const recapSlug = buildSlug(myDisplay?.abbr ?? franchise.abbr, oppDisplay?.abbr ?? a.opponentAbbr, 17);
                return (
                  <li class={a.won ? 'is-win' : 'is-loss'}>
                    <a href={`/games/${a.year}/${recapSlug}`}>
                      <span class="margin-result">{a.won ? 'Champion' : 'Runner-Up'}</span>
                      <span class="margin-detail">{a.label} &middot; vs. {oppDisplay?.abbr ?? a.opponentAbbr}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {confChamps.length > 0 && (
          <section class="margin-block">
            <h2 class="margin-head">{franchise.conf} Titles</h2>
            <p class="margin-years">
              {confChamps.map(sc => <a href={`/history/${sc.year}`}>{sc.year}</a>)}
            </p>
          </section>
        )}

        {myBowlGames.length > 0 && (
          <section class="margin-block">
            <h2 class="margin-head">{spotlightYear} Bowl Games</h2>
            <ul class="margin-list">
              {myBowlGames.map(bg => {
                const oppAbbr = getSpotlightOpponent(bg);
                const opp = getOpponentFranchise(oppAbbr);
                return (
                  <li>
                    <a href={`/spotlight-games/${bg.slug}`}>
                      <span class="margin-game">{bg.name}</span>
                      <span class="margin-detail">vs. {opp?.name ?? oppAbbr}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {myRivalryGames.length > 0 && (
          <section class="margin-block">
            <h2 class="margin-head">{spotlightYear} Rivalry Week</h2>
            <ul class="margin-list">
              {myRivalryGames.map(rg => {
                const oppAbbr = getSpotlightOpponent(rg);
                const opp = getOpponentFranchise(oppAbbr);
                return (
                  <li>
                    <a href={`/spotlight-games/${rg.slug}`}>

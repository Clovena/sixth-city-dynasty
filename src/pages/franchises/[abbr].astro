<script is:inline define:vars={{ matchupsData, franchiseIdentities, dynastyBowls, recapSlugsArr, defaultSeasonYear, abbr, sleeperId }}>
  const seasonSelect = document.getElementById('franchise-season-select');
  const grid = document.getElementById('franchise-games-grid');

  const recapSlugs = new Set(recapSlugsArr);

  function makeSlug(week, abbrA, abbrB) {
    const pad = String(week).padStart(2, '0');
    const [t1, t2] = [abbrA.toLowerCase(), abbrB.toLowerCase()].sort();
    return `${pad}-${t1}-${t2}`;
  }

  // Resolve identity for a sleeper_id at a given year
  function getIdentity(sid, year) {
    const identities = franchiseIdentities[String(sid)] ?? [];
    return identities.find(i => i.from <= year && (i.to === null || i.to >= year))
      ?? identities[identities.length - 1]
      ?? { abbr: 'UNK', name: `Roster ${sid}` };
  }

  function renderGames(year) {
    const yearStr = String(year);
    const allWeeks = matchupsData[yearStr] ?? {};

    const gamesByWeek = {};

    for (const [weekStr, entries] of Object.entries(allWeeks)) {
      const week = Number(weekStr);
      const franchiseMatches = entries.filter(e => e.roster_id === sleeperId);

      if (franchiseMatches.length === 0) continue;

      for (const franchiseEntry of franchiseMatches) {
        if (!franchiseEntry.matchup_id) continue;

        const opponent = entries.find(
          e => e.matchup_id === franchiseEntry.matchup_id && e.roster_id !== sleeperId
        );

        if (!opponent) continue;

        if (!gamesByWeek[week]) gamesByWeek[week] = [];
        gamesByWeek[week].push({
          franchiseScore: franchiseEntry.score,
          opponentRosterId: opponent.roster_id,
          opponentScore: opponent.score,
        });
      }
    }

    const weeks = Object.keys(gamesByWeek)
      .map(Number)
      .sort((a, b) => a - b);

    if (weeks.length === 0) {
      grid.innerHTML = '<p class="franchise-no-games">No games available for this season.</p>';
      return;
    }

    let html = '';
    for (const week of weeks) {
      for (const game of gamesByWeek[week]) {
        const myIdentity = getIdentity(sleeperId, year);
        const oppIdentity = getIdentity(game.opponentRosterId, year);

        const scoreFranchise = game.franchiseScore;
        const scoreOpponent = game.opponentScore;
        const franchiseWins = scoreFranchise > scoreOpponent;
        const opponentWins = scoreOpponent > scoreFranchise;

        // Dynasty Bowl banner (week 17 only)
        let banner = '';
        if (week === 17) {
          const db = dynastyBowls[yearStr];
          if (db) {
            const mySid = String(sleeperId);
            const oppSid = String(game.opponentRosterId);
            if (
              (mySid === db.winnerSleeperId || mySid === db.loserSleeperId) &&
              (oppSid === db.winnerSleeperId || oppSid === db.loserSleeperId)
            ) {
              banner = `<div class="franchise-dynasty-bowl-banner">${db.label}</div>`;
            }
          }
        }

        const slug = makeSlug(week, myIdentity.abbr, oppIdentity.abbr);
        const gameUrl = `/games/${year}/${slug}`;
        const hasRecap = recapSlugs.has(`${year}/${slug}`);

        html += `
          <a class="franchise-matchup-card" href="${gameUrl}">
            ${banner}
            <div class="franchise-matchup-week-header">Week ${week}</div>
            <div class="franchise-matchup-body">
              <div class="franchise-matchup-teams">
                ${teamRow(myIdentity, scoreFranchise, franchiseWins, opponentWins)}
                ${teamRow(oppIdentity, scoreOpponent, opponentWins, franchiseWins)}
              </div>
              ${hasRecap ? `<div class="franchise-recap-btn">Recap&nbsp;→</div>` : ''}
            </div>
          </a>`;
      }
    }

    if (!html) {
      grid.innerHTML = '<p class="franchise-no-games">No games available for this season.</p>';
      return;
    }

    grid.innerHTML = `<div class="franchise-matchups-grid">${html}</div>`;
  }

  function teamRow(identity, score, isWinner, isLoser) {
    const cls = isWinner ? 'winner' : isLoser ? 'loser' : 'tied';

    return `
      <div class="franchise-team-row ${cls}">
        <img class="franchise-team-logo"
             src="/images/logos/${identity.abbr}.png"
             alt="${identity.name}"
             onerror="this.style.display='none'" />
        <span class="franchise-team-name">${identity.name}</span>
        <span class="franchise-team-score">${score.toFixed(2)}</span>
      </div>`;
  }

  // Wire up event listener
  seasonSelect?.addEventListener('change', () => {
    renderGames(Number(seasonSelect.value));
  });

  // Initial render
  renderGames(defaultSeasonYear);
</script>

<!-- Game-by-game performance chart (Widget A) -->
<script is:inline define:vars={{ gamePerf, perfDefaultSeason }}>
  const perfWrap = document.getElementById('perf-chart-wrap');
  const perfTip = document.getElementById('perf-tooltip');
  const perfSelect = document.getElementById('perf-season-select');

  if (perfWrap && gamePerf.length) {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

    // Chart geometry
    const TOP = 18, BOTTOM = 30, CHART_H = 300, LEFT = 34, RIGHT = 8;
    const SVG_H = TOP + CHART_H + BOTTOM;
    const HALF = CHART_H / 2;
    const MIN_SLOT = 9, MAX_SLOT = 44;

    const pad2 = (w) => String(w).padStart(2, '0');
    function gameUrl(g) {
      const [a, b] = [g.myAbbr.toLowerCase(), g.oppAbbr.toLowerCase()].sort();
      return `/games/${g.year}/${pad2(g.week)}-${a}-${b}`;
    }

    // Desktop → whole history; mobile → one season at a time.
    function currentGames() {
      if (isMobile()) {
        const yr = Number(perfSelect?.value ?? perfDefaultSeason);
        return gamePerf.filter((g) => g.year === yr);
      }
      return gamePerf;
    }

    function render() {
      const games = currentGames();
      perfWrap.innerHTML = '';
      if (!games.length) return;

      const maxAbs = Math.max(1, ...games.map((g) => Math.abs(g.diff)));
      const niceMax = Math.max(20, Math.ceil(maxAbs / 20) * 20);
      const scale = HALF / niceMax;
      const baseY = TOP + HALF;

      const avail = perfWrap.clientWidth || 900;
      const n = games.length;
      const slot = Math.min(MAX_SLOT, Math.max(MIN_SLOT, (avail - LEFT - RIGHT) / n));
      const svgW = Math.max(avail, LEFT + RIGHT + slot * n);
      const barW = Math.max(3, slot * 0.66);

      const parts = [];

      // Differential gridlines + zero baseline
      for (const v of [niceMax, niceMax / 2, 0, -niceMax / 2, -niceMax]) {
        const y = baseY - v * scale;
        const zero = v === 0;
        parts.push(
          `<line x1="${LEFT}" y1="${y}" x2="${svgW - RIGHT}" y2="${y}" ` +
          `style="stroke:var(--color-border${zero ? '-light' : ''})" stroke-width="${zero ? 1.5 : 1}"` +
          `${zero ? '' : ' stroke-dasharray="2 3"'} />`
        );
        parts.push(
          `<text x="${LEFT - 6}" y="${y + 3}" text-anchor="end" font-size="9" ` +
          `style="fill:var(--color-text-muted)">${v > 0 ? '+' : ''}${v}</text>`
        );
      }

      // Bars + per-season dividers/labels
      let prevYear = null;
      for (let i = 0; i < n; i++) {
        const g = games[i];
        const x = LEFT + i * slot;

        if (g.year !== prevYear) {
          if (prevYear !== null) {
            parts.push(
              `<line x1="${x}" y1="${TOP - 6}" x2="${x}" y2="${TOP + CHART_H + 6}" ` +
              `style="stroke:var(--color-border)" stroke-width="1" />`
            );
          }
          parts.push(
            `<text x="${x + 2}" y="${SVG_H - 9}" text-anchor="start" font-size="11" ` +
            `font-weight="600" style="fill:var(--color-text-secondary)">${g.year}</text>`
          );
          prevYear = g.year;
        }

        const color = g.result === 'W' ? 'var(--status-win)'
                    : g.result === 'L' ? 'var(--status-loss)'
                    : 'var(--status-tie)';
        let h, by;
        if (g.result === 'T') { h = 2; by = baseY - 1; }
        else { h = Math.max(1.5, Math.abs(g.diff) * scale); by = g.diff >= 0 ? baseY - h : baseY; }

        const bx = x + (slot - barW) / 2;
        parts.push(
          `<rect class="perf-bar" data-idx="${i}" x="${bx.toFixed(1)}" y="${by.toFixed(1)}" ` +
          `width="${barW.toFixed(1)}" height="${h.toFixed(1)}" rx="1" style="fill:${color}" />`
        );
      }

      perfWrap.innerHTML =
        `<svg width="${svgW}" height="${SVG_H}" viewBox="0 0 ${svgW} ${SVG_H}" ` +
        `role="img" aria-label="Regular-season point differential, game by game" ` +
        `style="display:block;font-family:var(--font-body)">${parts.join('')}</svg>`;

      perfWrap._games = games;
    }

    function barFromEvent(e) {
      const el = e.target.closest('.perf-bar');
      if (!el) return null;
      return (perfWrap._games || [])[Number(el.dataset.idx)] ?? null;
    }

    perfWrap.addEventListener('click', (e) => {
      const g = barFromEvent(e);
      if (g) window.location.href = gameUrl(g);
    });

    // Tooltip: desktop / hover-capable pointers only.
    if (canHover) {
      perfWrap.addEventListener('mousemove', (e) => {
        const g = barFromEvent(e);
        if (!g) { perfTip.hidden = true; return; }

        const resTxt = g.result === 'W' ? 'Win' : g.result === 'L' ? 'Loss' : 'Tie';
        const cls = g.result === 'W' ? 'perf-tt-win' : g.result === 'L' ? 'perf-tt-loss' : '';
        const sign = g.diff > 0 ? '+' : '';

        perfTip.innerHTML =
          `<strong>${g.year} · Wk ${g.week}</strong>` +
          `<span class="perf-tt-result"><span class="perf-tt-margin ${cls}">${resTxt} ${sign}${g.diff.toFixed(1)}</span> vs ${g.oppAbbr}</span>`;
        perfTip.hidden = false;

        const GAP = 14;
        const tw = perfTip.offsetWidth, th = perfTip.offsetHeight;
        let left = e.clientX + GAP, top = e.clientY + GAP;
        if (left + tw > window.innerWidth - 8) left = e.clientX - tw - GAP;
        if (top + th > window.innerHeight - 8) top = e.clientY - th - GAP;
        perfTip.style.left = `${left}px`;
        perfTip.style.top = `${top}px`;
      });
      perfWrap.addEventListener('mouseleave', () => { perfTip.hidden = true; });
    }

    perfSelect?.addEventListener('change', render);

    let perfResizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(perfResizeTimer);
      perfResizeTimer = setTimeout(render, 120);
    });

    render();
  }
</script>

---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { loadSeasonPodiums, loadMedals, loadRecords } from '../../lib/hall-of-fame';
import { loadFranchises, franchiseForYear, activeFranchise, logoPath } from '../../lib/franchise-identity';
import { ordinal, playerName, formatPoints } from '../../lib/format';

const franchises = await loadFranchises();

const [podiums, medals, records, { data: accoladeRows, error: aErr }] = await Promise.all([
  loadSeasonPodiums(franchises),
  loadMedals(),
  loadRecords(franchises, 10),
  supabase
    .schema('scdfl')
    .from('accolades')
    .select('year, award_code, award_desc, player_id, sleeper_id, transaction_id')
    .order('year', { ascending: false })
    .limit(500),
]);

if (aErr) throw new Error(`Accolades query failed: ${aErr.message}`);

const accolades = accoladeRows ?? [];

// ── Wings ─────────────────────────────────────────────────────────────────
// Each wing carries its own tally, so the index reads as a table of contents
// with weights rather than five identical tiles.
const wings = [
  { name: 'Champions', slug: 'champions', line: 'What we all play for.', locked: false, note: `${podiums.length} seasons decided` },
  { name: 'Superlatives', slug: 'superlatives', line: 'Awards for the people, by the people.', locked: false, note: `${accolades.length} awards voted` },
  { name: 'Medals', slug: 'medals', line: 'Players who reached the summit.', locked: false, note: `${medals.length} medals struck` },
  { name: 'Records', slug: 'records', line: 'The league\'s most unforgettable moments.', locked: false, note: 'Team and player highs' },
  { name: 'Hall of Famers', slug: 'inductees', line: 'The legends of Sixth City.', locked: true, note: 'Opens after Season VI' },
];

// ── Hero counts ───────────────────────────────────────────────────────────
const seasonsComplete = podiums.length;
const franchisesCrowned = new Set(podiums.map(p => p.champion?.activeAbbr).filter(Boolean)).size;
const medalsAwarded = medals.length;
const awardsVoted = accolades.length;

// ── Recent additions ──────────────────────────────────────────────────────
const latestPodium = podiums[0] ?? null;

const latestAccoladeYear = accolades.length ? Math.max(...accolades.map(a => a.year)) : null;
const latestAccolade = latestAccoladeYear === null
  ? null
  : accolades.filter(a => a.year === latestAccoladeYear).find(a => a.award_code === 'mvp')
    ?? accolades.find(a => a.year === latestAccoladeYear)
    ?? null;

const latestMedalYear = medals.length ? Math.max(...medals.map(m => m.year)) : null;
const latestMedal = latestMedalYear === null
  ? null
  : [...medals.filter(m => m.year === latestMedalYear)].sort((a, b) => Number(b.fpts) - Number(a.fpts))[0] ?? null;
const latestMedalCount = latestMedalYear === null
  ? 0
  : medals.filter(m => m.year === latestMedalYear).length;

// Newest entry standing anywhere in either record book.
type RecordHighlight = {
  kind: 'team' | 'player';
  rank: number;
  year: number;
  week: number;
  who: string;
  detail: string;
  score: number;
};

const recordHighlights: RecordHighlight[] = [
  ...records.teamScores.map((record, i) => ({
    kind: 'team' as const,
    rank: i + 1,
    year: record.year,
    week: record.week,
    who: record.team?.name ?? '—',
    detail: `vs. ${record.opponent?.abbr ?? '—'}`,
    score: record.score,
  })),
  ...records.playerScores.map((record, i) => ({
    kind: 'player' as const,
    rank: i + 1,
    year: record.year,
    week: record.week,
    who: record.name,
    detail: `${record.position} • ${record.team?.abbr ?? '—'}`,
    score: record.points,
  })),
];

const newestRecord = recordHighlights.sort((a, b) => b.year - a.year || b.week - a.week)[0] ?? null;

// ── Names for the two people surfaced above ───────────────────────────────
const spotlightPlayerIds = [latestAccolade?.player_id, latestMedal?.player_id].filter(Boolean) as string[];

const { data: spotlightPlayers, error: pErr } = spotlightPlayerIds.length
  ? await supabase
      .schema('scdfl')
      .from('v_players')
      .select('player_id, first_name, last_name, position, team, espn_id')
      .in('player_id', spotlightPlayerIds)
  : { data: [], error: null };

if (pErr) throw new Error(`Players query failed: ${pErr.message}`);

const playerById = new Map((spotlightPlayers ?? []).map(p => [p.player_id, p]));

function playerLabel(id: string | null | undefined): string {
  if (!id) return '—';
  const p = playerById.get(id);
  return playerName(p?.first_name, p?.last_name, id);
}

/** Manager/trade awards have no player, so resolve the franchise instead. */
function accoladeSubject(accolade: typeof accolades[number] | null): string {
  if (!accolade) return '—';
  if (accolade.player_id) return playerLabel(accolade.player_id);
  if (accolade.sleeper_id) {
    const era = franchiseForYear(franchises, accolade.sleeper_id, accolade.year);
    const active = activeFranchise(franchises, accolade.sleeper_id);
    return (era ?? active)?.name ?? '—';
  }
  return 'A multi-team trade';
}

const medalPlayerName = playerLabel(latestMedal?.player_id);

type RecentCard = {
  wing: string;
  href: string;
  eyebrow: string;
  headline: string;
  detail: string;
  logoAbbr?: string | null;
};

const recentCards: RecentCard[] = [];

if (latestPodium?.champion) {
  recentCards.push({
    wing: 'Champions',
    href: '/hall-of-fame/champions',
    eyebrow: `${latestPodium.year} • ${latestPodium.dynastyBowlLabel}`,
    headline: latestPodium.champion.name,
    detail: latestPodium.charity
      ? `Champion • played for ${latestPodium.charity}`
      : 'Champion',
    logoAbbr: latestPodium.champion.abbr,
  });
}

if (latestAccolade) {
  recentCards.push({
    wing: 'Superlatives',
    href: '/hall-of-fame/superlatives',
    eyebrow: `${latestAccolade.year} • ${latestAccolade.award_desc}`,
    headline: accoladeSubject(latestAccolade),
    detail: `Voted by the league • ${accolades.filter(a => a.year === latestAccolade.year).length} awards that season`,
  });
}

if (latestMedal) {
  recentCards.push({
    wing: 'Medals',
    href: '/hall-of-fame/medals',
    eyebrow: `${latestMedal.year} • ${latestMedal.position} Medalist`,
    headline: medalPlayerName,
    detail: `${formatPoints(Number(latestMedal.fpts))} pts • ${latestMedalCount} medals awarded that season`,
  });
}

if (newestRecord) {
  recentCards.push({
    wing: 'Records',
    href: '/hall-of-fame/records',
    eyebrow: `${newestRecord.year} • Week ${newestRecord.week}`,
    headline: newestRecord.who,
    detail: `${formatPoints(newestRecord.score)} — ${ordinal(newestRecord.rank)}-highest ${newestRecord.kind === 'team' ? 'team score' : 'player score'} all-time`,
  });
}
---

<Layout
  title="Hall of Fame"
  description="The Sixth City Dynasty Hall of Fame — champions, superlatives, medals, records, and the legends of the league."
>
  <!-- Hero -->
  <!-- No blanket stripe here: the masthead already carries one, and a second
       one 150px below it reads as a repeated component rather than a motif. -->
  <section class="hof-hero" data-theme="ink">
    <div class="hof-hero-inner">
      <img src="/brand/emblem_white.svg" width="120" height="120" alt="" class="hof-hero-emblem" />
      <p class="hof-hero-eyebrow">Sixth City Dynasty</p>
      <h1 class="hof-hero-title">HALL OF FAME</h1>
      <p class="hof-hero-lede">
        A compendium of Sixth City's shared history. Everything the league has decided is worth remembering on the field, in the owners' boxes, or by the numbers.
      </p>
    </div>
  </section>

  <!-- Wing index: a table of contents, not five tiles. -->
  <div class="wrap wing-section">
    <ol class="wing-index">
      {wings.map((wing, i) => {
        const Tag = wing.locked ? 'div' : 'a';
        return (
          <li class={`wing-row${wing.locked ? ' is-locked' : ''}`}>
            <Tag href={wing.locked ? undefined : `/hall-of-fame/${wing.slug}`} class="wing-link">
              <span class="wing-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="wing-body">
                <span class="wing-name">{wing.name}</span>
                <span class="wing-line">{wing.line}</span>
              </span>
              <span class="wing-note">{wing.note}</span>
            </Tag>
          </li>
        );
      })}
    </ol>
  </div>

  <!-- Newest entry in each wing, as a ruled index rather than four cards. -->
  {recentCards.length > 0 && (
    <section class="band recent-band">
      <div class="wrap">
        <div class="almanac-head">
          <h2>Recent Additions</h2>
          <span class="folio">The newest entry in each wing</span>
        </div>

        <div class="recent-index">
          {recentCards.map(card => (
            <a href={card.href} class="recent-entry">
              <span class="recent-wing">{card.wing}</span>
              <span class="recent-main">
                {card.logoAbbr && (
                  <img src={logoPath(card.logoAbbr)} alt="" width="30" height="30" onerror="this.style.display='none'" />
                )}
                <span class="recent-headline">{card.headline}</span>
              </span>
              <span class="recent-eyebrow">{card.eyebrow}</span>
              <span class="recent-detail">{card.detail}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  /* ---- Hero — broadcast band ---- */
  .hof-hero {
    background-color: var(--surface-ink);
    color: var(--text-strong);
  }
  .hof-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2.75rem;
    text-align: center;
  }
  .hof-hero-emblem { display: block; margin: 0 auto 1rem; }

  .hof-hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin: 0 0 0.6rem;
  }

  .hof-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 7rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    margin: 0;
  }

  .hof-hero-lede {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: var(--lh-relaxed);
    color: var(--text-body);
    max-width: 56ch;
    margin: 1rem auto 0;
  }

  /* ---- Wing index ---- */
  .wing-section { padding-top: 2.5rem; padding-bottom: 1rem; }
  .wing-index { list-style: none; margin: 0; padding: 0; }
  .wing-row { border-bottom: 1px solid var(--border-default); }
  .wing-row:first-child { border-top: 3px solid var(--rule-ink); }

  .wing-link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1rem 0.25rem;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  a.wing-link:hover { text-decoration: none; background-color: var(--surface-card); }

  .wing-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-disabled);
  }

  .wing-body { display: flex; flex-direction: column; min-width: 0; }
  .wing-name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--text-strong);
    transition: var(--transition-color);
  }
  a.wing-link:hover .wing-name { color: var(--ember-700); }
  .wing-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .wing-note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* A wing that has not opened yet reads as anticipated and is inert. */
  .wing-row.is-locked .wing-name { color: var(--ink-300); }
  .wing-row.is-locked .wing-link { cursor: default; }
  .wing-row.is-locked .wing-note { color: var(--ink-300); }

  /* ---- Recent additions ---- */
  .recent-band { margin-top: 3rem; padding: 2.75rem 0 3rem; }

  .recent-index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 0 2.5rem;
  }

  .recent-entry {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 0;
    border-bottom: 1px dotted var(--border-default);
    text-decoration: none;
  }
  .recent-entry:hover { text-decoration: none; }
  .recent-entry:hover .recent-headline { color: var(--ember-700); }

  .recent-wing {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ember-700);
  }

  .recent-main { display: flex; align-items: center; gap: 0.55rem; }
  .recent-main img { object-fit: contain; flex-shrink: 0; }

  .recent-headline {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.05;
    color: var(--text-strong);
    transition: var(--transition-color);
  }

  .recent-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .recent-detail {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  @media (max-width: 768px) {
    .hof-hero-inner { padding: 2.25rem 1.5rem 2rem; }
    .hof-hero-emblem { width: 84px; height: 84px; }

    .wing-link { grid-template-columns: 2rem minmax(0, 1fr); gap: 0.85rem; }
    .wing-note { grid-column: 2; margin-top: 0.35rem; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { supabase } from '../lib/supabase';
import {
  loadFranchises,
  franchiseForYear,
  franchiseByAbbrForYear,
  activeFranchise,
  identityFor,
  logoPath,
  primaryColor,
} from '../lib/franchise-identity';
import { loadChampionshipMatchups, buildSlug, gameHref, isPlayablePostseasonGame } from '../lib/game-utils';
import { toRoman, formatPoints, primaryColorOnInk } from '../lib/format';
import { loadNflState, activeWeekFor } from '../lib/nfl-state';
import { loadSeasonPicture } from '../lib/season-picture';
import PlayoffBracket from '../components/PlayoffBracket.astro';

// ─────────────────────────────────────────────────────────────────────────────
// DATA
// The front page is assembled from the record itself: results, matchups,
// seasons, the bowl-game slate, and the newest piece of writing. Nothing
// here is decorative — every number on the page is one the league played for.
// ─────────────────────────────────────────────────────────────────────────────
const [franchises, champMatchups, seasonsRes, resultsRes, matchupsRes, exhibitionsRes, slateRes, ledeEntries, nflState] =
  await Promise.all([
    loadFranchises(),
    loadChampionshipMatchups(),
    supabase
      .schema('scdfl')
      .from('seasons')
      .select('year, charity, scc_champion, hcc_champion, playoff_teams')
      .order('year'),
    supabase
      .schema('scdfl')
      .from('results')
      .select('sleeper_id, year, wins, losses, ties, points_for, points_against, seed, finish, playoff')
      .limit(1000),
    supabase
      .schema('scdfl')
      .from('matchups')
      .select('year, week, matchup_id, game_type, roster_id_a, roster_id_b, score_a, score_b')
      .limit(1000),
    supabase
      .schema('scdfl')
      .from('exhibitions')
      .select('year, week, team_a_slug, team_a_display_name, team_a_members, team_b_slug, team_b_display_name, team_b_members, exhibition_matchups(score_a, score_b)')
      .limit(500),
    supabase
      .schema('scdfl')
      .from('spotlight_game_years')
      .select('slug, year, spotlight_games(slug, name, type, team_a, team_b)')
      .limit(500),
    getCollection('homepage'),
    loadNflState(),
  ]);

if (seasonsRes.error) throw new Error(`Seasons query failed: ${seasonsRes.error.message}`);
if (resultsRes.error) throw new Error(`Results query failed: ${resultsRes.error.message}`);
if (matchupsRes.error) throw new Error(`Matchups query failed: ${matchupsRes.error.message}`);
if (exhibitionsRes.error) throw new Error(`Exhibitions query failed: ${exhibitionsRes.error.message}`);
if (slateRes.error) throw new Error(`Spotlight slate query failed: ${slateRes.error.message}`);

const seasons = seasonsRes.data ?? [];
const results = resultsRes.data ?? [];
const matchups = matchupsRes.data ?? [];
const exhibitions = exhibitionsRes.data ?? [];

const currentYear = Math.max(...seasons.map(s => s.year));

// ── The featured game: this week's headline game, top of the score rail ──────
// Which game is featured follows the live NFL state rather than the archive, so
// the front page turns over with the schedule — `matchups` holds the full
// season from the day the Sleeper league is created, so "latest week with rows"
// runs ahead of the week actually being played. (The `lede*` names date from
// when this game was the centre lede; the playoff picture holds that now.)
const ledeCopy = ledeEntries.find(e => e.id === 'lede-blurb')?.data ?? null;

// `status` (src/content/homepage/lede-blurb.md) is the editorial call on where
// the week stands, and it governs every scorebug on the page — the featured
// game and the rest of the rail alike. Only a finished
// week gets marked winners; while it is live, figures move and a gold marker
// would just be asserting a result that hasn't happened. Both sides then read
// in parchment, however they happen to sit.
const weekIsFinal = ledeCopy?.status === 'final';

const ledeYear =
  nflState.season !== null && matchups.some(m => m.year === nflState.season)
    ? nflState.season
    : Math.max(...matchups.map(m => m.year));

const ledeWeeks = [...new Set(matchups.filter(m => m.year === ledeYear).map(m => m.week))]
  .sort((a, b) => a - b);

// Falls back to the first week on the schedule when the state fetch failed or
// the live week has no rows yet, then clamps to a week that actually exists.
const targetWeek = activeWeekFor(nflState, ledeYear) ?? ledeWeeks[0] ?? 1;
const ledeWeek = ledeWeeks.includes(targetWeek)
  ? targetWeek
  : ledeWeeks.filter(w => w <= targetWeek).pop() ?? ledeWeeks[0] ?? targetWeek;

// An exhibition outranks the regular slate: it is the week's one-off, so when
// the live week has one it leads the front page. Otherwise "first game of the
// week" is matchup_id order — the order Sleeper posts them.
const ledeExhibition = exhibitions.find(e => e.year === ledeYear && e.week === ledeWeek) ?? null;
const ledeGame = ledeExhibition
  ? null
  : matchups
      .filter(m => m.year === ledeYear && m.week === ledeWeek && m.matchup_id)
      .sort((a, b) => a.matchup_id - b.matchup_id)[0] ?? null;

// One shape for both kinds of game. A regular side is one club; an exhibition
// side is a squad of `members` abbrs (two for a tag-team, one for either side
// of a one-vs-all, where "WORLD" has a logo but no franchise row).
type LedeSide = {
  /** Era abbrs, one logo each */
  crests: string[];
  /** Short scorebug label */
  label: string;
  /** Full name for the credit line */
  name: string;
  /** Franchise page, or null for a composite squad */
  href: string | null;
  /** Keel colour, already adjusted for the ink slab */
  keel: string;
};

type LedeGame = {
  sideA: LedeSide;
  sideB: LedeSide;
  scoreA: number;
  scoreB: number;
  aWon: boolean;
  bWon: boolean;
  href: string | null;
};

function clubSide(rosterId: number): LedeSide {
  const era = franchiseForYear(franchises, String(rosterId), ledeYear);
  const active = activeFranchise(franchises, String(rosterId));
  return {
    crests: era ? [era.abbr] : [],
    label: era?.abbr ?? '',
    name: era?.name ?? '',
    href: active ? `/franchises/${active.abbr}` : null,
    keel: primaryColorOnInk(era?.colors),
  };
}

// Members are stored as the abbr in use at exhibition time. A lone member that
// resolves to a franchise links to it; a squad has no single page to link to.
function squadSide(members: string[], displayName: string): LedeSide {
  const clubs = members.map(abbr => franchiseByAbbrForYear(franchises, abbr, ledeYear));
  const solo = members.length === 1 && clubs[0] ? activeFranchise(franchises, clubs[0].sleeper_id) : undefined;
  return {
    crests: members,
    label: members.join('/'),
    name: displayName,
    href: solo ? `/franchises/${solo.abbr}` : null,
    keel: primaryColorOnInk(clubs.find(Boolean)?.colors),
  };
}

function ledeFrom(sideA: LedeSide, sideB: LedeSide, scoreA: number, scoreB: number, href: string | null): LedeGame {
  return {
    sideA,
    sideB,
    scoreA,
    scoreB,
    aWon: weekIsFinal && scoreA > scoreB,
    bWon: weekIsFinal && scoreB > scoreA,
    href,
  };
}

let lede: LedeGame | null = null;
if (ledeExhibition) {
  const score = ledeExhibition.exhibition_matchups?.[0];
  lede = ledeFrom(
    squadSide(ledeExhibition.team_a_members ?? [], ledeExhibition.team_a_display_name),
    squadSide(ledeExhibition.team_b_members ?? [], ledeExhibition.team_b_display_name),
    Number(score?.score_a ?? 0),
    Number(score?.score_b ?? 0),
    `/games/${ledeYear}/${buildSlug(ledeExhibition.team_a_slug, ledeExhibition.team_b_slug, ledeWeek)}`,
  );
} else if (ledeGame) {
  lede = ledeFrom(
    clubSide(ledeGame.roster_id_a),
    clubSide(ledeGame.roster_id_b),
    ledeGame.score_a ?? 0,
    ledeGame.score_b ?? 0,
    gameHref(
      ledeYear,
      ledeWeek,
      identityFor(franchises, ledeGame.roster_id_a, ledeYear),
      identityFor(franchises, ledeGame.roster_id_b, ledeYear),
    ),
  );
}

// ── The lede: the playoff picture ────────────────────────────────────────────
// Through the regular season it is a projection off the live standings. Once
// the bracket is set it is the real one, and through the offseason it stays on
// the last completed season until the next one has a game on the books.
let picture = await loadSeasonPicture(ledeYear, franchises);
if (picture.phase === 'pre' && champMatchups.length > 0) {
  picture = await loadSeasonPicture(Math.max(...champMatchups.map(m => m.year)), franchises);
}

const pictureChampion = picture.teams.find(t => t.rosterId === picture.bracket.champion?.rosterId);
const pictureHead =
  picture.phase === 'regular' ? { title: 'Playoff Picture', tail: `If the season ended after Week ${picture.lockedThrough}` }
  : picture.phase === 'post' ? { title: `${picture.year} Playoffs`, tail: 'The bracket is set' }
  : { title: `Dynasty Bowl ${toRoman(picture.year - 2020)}`, tail: pictureChampion ? `${pictureChampion.name}, champions` : `The ${picture.year} bracket` };

// ── The slate: latest played week, or the next set of fixtures if none ───────
const yearsWithGames = [...new Set(matchups.map(m => m.year))].sort((a, b) => b - a);
const slateYear = yearsWithGames[0] ?? currentYear;
const slateYearGames = matchups.filter(m => m.year === slateYear);
const playedWeeks = [...new Set(slateYearGames.filter(m => m.score_a > 0 || m.score_b > 0).map(m => m.week))];

const slateIsFixtures = playedWeeks.length === 0;
const slateWeek = slateIsFixtures ? Math.min(...slateYearGames.map(m => m.week)) : Math.max(...playedWeeks);

const slate = slateYearGames
  .filter(m => m.week === slateWeek && m.matchup_id)
  .filter(m => isPlayablePostseasonGame(m.game_type, m.score_a, m.score_b) || slateIsFixtures)
  // The lede already carries this week's headline game at full size; repeating
  // it in the rail below would be the same result posted twice. Matched on the
  // full key, so nothing is dropped when the lede week and the slate week
  // differ (they do whenever the live week has no rows yet).
  .filter(m => !(
    ledeGame &&
    m.year === ledeGame.year &&
    m.week === ledeGame.week &&
    m.matchup_id === ledeGame.matchup_id
  ))
  .sort((a, b) => a.matchup_id - b.matchup_id)
  .map(m => {
    const a = identityFor(franchises, m.roster_id_a, slateYear);
    const b = identityFor(franchises, m.roster_id_b, slateYear);
    return {
      a, b,
      scoreA: m.score_a ?? 0,
      scoreB: m.score_b ?? 0,
      href: gameHref(slateYear, slateWeek, a, b),
    };
  })
  .filter(g => g.a && g.b);

// ── The record book: extremes, computed over every game ever played ──────────
const played = matchups.filter(
  m => m.matchup_id && (m.score_a > 0 || m.score_b > 0) && isPlayablePostseasonGame(m.game_type, m.score_a, m.score_b),
);

type Extreme = { label: string; value: string; line: string; href: string | null; year: number; week: number };

function sideName(rosterId: number, year: number): string {
  return identityFor(franchises, rosterId, year)?.name ?? '—';
}
function hrefFor(m: typeof played[number]): string | null {
  return gameHref(m.year, m.week, identityFor(franchises, m.roster_id_a, m.year), identityFor(franchises, m.roster_id_b, m.year));
}

const highestSingle = [...played].sort(
  (a, b) => Math.max(b.score_a, b.score_b) - Math.max(a.score_a, a.score_b),
)[0];
const widestMargin = [...played]
  .filter(m => m.score_a > 0 && m.score_b > 0)
  .sort((a, b) => Math.abs(b.score_a - b.score_b) - Math.abs(a.score_a - a.score_b))[0];
const narrowestMargin = [...played]
  .filter(m => m.score_a > 0 && m.score_b > 0)
  .sort((a, b) => Math.abs(a.score_a - a.score_b) - Math.abs(b.score_a - b.score_b))[0];
const highestCombined = [...played]
  .filter(m => m.score_a > 0 && m.score_b > 0)
  .sort((a, b) => b.score_a + b.score_b - (a.score_a + a.score_b))[0];

const recordBook: Extreme[] = [];
if (highestSingle) {
  const topIsA = highestSingle.score_a >= highestSingle.score_b;
  recordBook.push({
    label: 'Highest score',
    value: formatPoints(Math.max(highestSingle.score_a, highestSingle.score_b)),
    line: sideName(topIsA ? highestSingle.roster_id_a : highestSingle.roster_id_b, highestSingle.year),
    href: hrefFor(highestSingle), year: highestSingle.year, week: highestSingle.week,
  });
}
if (widestMargin) {
  const winIsA = widestMargin.score_a > widestMargin.score_b;
  recordBook.push({
    label: 'Widest margin',
    value: formatPoints(Math.abs(widestMargin.score_a - widestMargin.score_b)),
    line: `${sideName(winIsA ? widestMargin.roster_id_a : widestMargin.roster_id_b, widestMargin.year)} over ${sideName(winIsA ? widestMargin.roster_id_b : widestMargin.roster_id_a, widestMargin.year)}`,
    href: hrefFor(widestMargin), year: widestMargin.year, week: widestMargin.week,
  });
}
if (narrowestMargin) {
  const winIsA = narrowestMargin.score_a > narrowestMargin.score_b;
  recordBook.push({
    label: 'Narrowest margin',
    value: formatPoints(Math.abs(narrowestMargin.score_a - narrowestMargin.score_b)),
    line: `${sideName(winIsA ? narrowestMargin.roster_id_a : narrowestMargin.roster_id_b, narrowestMargin.year)} over ${sideName(winIsA ? narrowestMargin.roster_id_b : narrowestMargin.roster_id_a, narrowestMargin.year)}`,
    href: hrefFor(narrowestMargin), year: narrowestMargin.year, week: narrowestMargin.week,
  });
}
if (highestCombined) {
  recordBook.push({
    label: 'Most points, one game',
    value: formatPoints(highestCombined.score_a + highestCombined.score_b),
    line: `${sideName(highestCombined.roster_id_a, highestCombined.year)} & ${sideName(highestCombined.roster_id_b, highestCombined.year)}`,
    href: hrefFor(highestCombined), year: highestCombined.year, week: highestCombined.week,
  });
}

// ── The standing order: every franchise, all-time, by winning percentage ─────
type StandingRow = {
  abbr: string; name: string; owner: string; conf: string; colors: string[];
  w: number; l: number; t: number; pf: number; seasons: number; titles: number; pct: number;
};

const titleCountBySleeperId = new Map<string, number>();
for (const m of champMatchups) {
  const id = String(m.score_a > m.score_b ? m.roster_id_a : m.roster_id_b);
  titleCountBySleeperId.set(id, (titleCountBySleeperId.get(id) ?? 0) + 1);
}

const standingOrder: StandingRow[] = franchises
  .filter(f => f.to === null)
  .map(f => {
    const rows = results.filter(r => r.sleeper_id === f.sleeper_id);
    const w = rows.reduce((n, r) => n + (r.wins ?? 0), 0);
    const l = rows.reduce((n, r) => n + (r.losses ?? 0), 0);
    const t = rows.reduce((n, r) => n + (r.ties ?? 0), 0);
    return {
      abbr: f.abbr, name: f.name, owner: f.owner, conf: f.conf, colors: f.colors,
      w, l, t,
      pf: rows.reduce((n, r) => n + Number(r.points_for ?? 0), 0),
      seasons: rows.length,
      titles: titleCountBySleeperId.get(f.sleeper_id) ?? 0,
      pct: w + l + t === 0 ? 0 : (w + t / 2) / (w + l + t),
    };
  })
  .sort((a, b) => b.pct - a.pct || b.pf - a.pf);

const completedSeasons = champMatchups.length;

// ── In season: the active season's table, split by conference ───────────────
// The all-time order is the offseason/preseason read. Once games count, the
// front page carries the live table instead. Anything other than an explicit
// 'regular'/'post' — including a failed state fetch — keeps the all-time view,
// since a table of 0–0 rows says nothing. The season is the lede's: the live
// Sleeper season when it has matchups, else the latest season on record.
const showSeasonStandings = nflState.seasonType === 'regular' || nflState.seasonType === 'post';
const standingsYear = ledeYear;

type SeasonStandingRow = {
  abbr: string; linkAbbr: string; name: string; colors: string[];
  w: number; l: number; t: number; pf: number; pa: number; pct: number;
};

const CONFERENCES = [
  { code: 'SCC', name: 'Senatorial Canadian Conference' },
  { code: 'HCC', name: 'House of Commons Conference' },
];

const seasonStandings = CONFERENCES.map(conf => ({
  ...conf,
  rows: results
    .filter(r => r.year === standingsYear)
    .flatMap((r): (SeasonStandingRow & { conf: string })[] => {
      const era = franchiseForYear(franchises, r.sleeper_id, standingsYear);
      if (!era) return [];
      const w = r.wins ?? 0;
      const l = r.losses ?? 0;
      const t = r.ties ?? 0;
      return [{
        abbr: era.abbr,
        linkAbbr: activeFranchise(franchises, r.sleeper_id)?.abbr ?? era.abbr,
        name: era.name,
        colors: era.colors,
        conf: era.conf,
        w, l, t,
        pf: Number(r.points_for ?? 0),
        pa: Number(r.points_against ?? 0),
        pct: w + l + t === 0 ? 0 : (w + t / 2) / (w + l + t),
      }];
    })
    .filter(row => row.conf === conf.code)
    // Ties in the table break on points for — the simplest honest tiebreak.
    .sort((a, b) => b.pct - a.pct || b.pf - a.pf),
}));

// Derived from scored regular-season games, not the live week, so the folio
// never claims a week whose results haven't been synced.
const scoredRegularWeeks = matchups
  .filter(m => m.year === standingsYear && m.game_type === 0 && (m.score_a > 0 || m.score_b > 0))
  .map(m => m.week);
const standingsThroughWeek = scoredRegularWeeks.length ? Math.max(...scoredRegularWeeks) : null;

// ── The bowl-game slate for the coming season ────────────────────────────────
type SpotlightEntry = { slug: string; name: string; type: string; teamA: string; teamB: string; since: number };

const spotlightBySlug = new Map<string, SpotlightEntry>();
for (const row of slateRes.data ?? []) {
  const g = row.spotlight_games as unknown as { slug: string; name: string; type: string; team_a: string; team_b: string } | null;
  if (!g) continue;
  const existing = spotlightBySlug.get(row.slug);
  if (existing) {
    existing.since = Math.min(existing.since, row.year);
  } else {
    spotlightBySlug.set(row.slug, {
      slug: g.slug, name: g.name, type: g.type, teamA: g.team_a, teamB: g.team_b, since: row.year,
    });
  }
}
const slateThisYear = new Set((slateRes.data ?? []).filter(r => r.year === currentYear).map(r => r.slug));

// Bowl games only. `spotlight_games.type` also carries 'rivalry', but Rivalry
// Week is redrawn every season and carries no history of its own, so it does
// not belong in a standing index — the bowls persist and accrue lore.
const bowlGames = [...spotlightBySlug.values()]
  .filter(g => slateThisYear.has(g.slug) && g.type === 'bowl-game')
  .sort((a, b) => a.since - b.since || a.name.localeCompare(b.name));

// ── Champions roll ───────────────────────────────────────────────────────────
const championsRoll = [...champMatchups]
  .sort((a, b) => b.year - a.year)
  .map(m => {
    const aWins = m.score_a > m.score_b;
    return {
      year: m.year,
      label: toRoman(m.year - 2020),
      champ: franchiseForYear(franchises, String(aWins ? m.roster_id_a : m.roster_id_b), m.year),
      loser: franchiseForYear(franchises, String(aWins ? m.roster_id_b : m.roster_id_a), m.year),
      scoreW: aWins ? m.score_a : m.score_b,
      scoreL: aWins ? m.score_b : m.score_a,
      charity: seasons.find(s => s.year === m.year)?.charity ?? null,
    };
  });
---

<Layout
  title="SCDFL"
  description="Sixth City Dynasty Football League — fourteen franchises, five completed seasons, and every score on record. Est. 2021."
>

  <!-- ══ FRONT PAGE ══════════════════════════════════════════════════════ -->
  <div class="wrap front-page">

    <!-- Centre: the lede — the playoff picture -->
    <article class="lede">
      <h1 class="lede-head">
        {pictureHead.title}
        <span class="lede-head-tail">{pictureHead.tail}</span>
      </h1>

      <div class="lede-bracket">
        <PlayoffBracket bracket={picture.bracket} label={`Dynasty Bowl ${toRoman(picture.year - 2020)}`} />
      </div>

      <p class="lede-credit">
        {picture.phase === 'regular' ? (
          <>
            <span>Conference leaders take seeds 1 and 2; the wild cards go on wins, then head-to-head, then points for.</span>
            <a href="/sim">Run the playoff simulator</a>
          </>
        ) : (
          <a href={`/history/${picture.year}`}>The {picture.year} season in full</a>
        )}
      </p>
    </article>

    <!-- Right rail: the featured game, then the rest of the week posted down the column -->
    {(lede || slate.length > 0) && (
      <aside class="rail-right" data-theme="ink">
        {lede && (
          <section class="feature">
            <h2 class="rail-head">Featured Game</h2>
            <p class="rail-stamp slugline">{ledeYear} &middot; Week {ledeWeek}</p>

            <a href={lede.href ?? '/scores'} class="feature-score">
              {[
                { side: lede.sideA, score: lede.scoreA, won: lede.aWon },
                { side: lede.sideB, score: lede.scoreB, won: lede.bWon },
              ].map(({ side, score, won }) => (
                <span
                  class:list={['feature-side', { 'is-squad': side.crests.length > 1 }]}
                  style={`--keel: ${side.keel}; --n: ${side.crests.length};`}
                >
                  <span class="feature-crests">
                    {side.crests.map(abbr => (
                      <img src={logoPath(abbr)} alt="" width="36" height="36" onerror="this.style.display='none'" />
                    ))}
                  </span>
                  <span class="feature-abbr">{side.label}</span>
                  <span class:list={['feature-num', { win: won }]}>{formatPoints(score)}</span>
                </span>
              ))}
            </a>

            <p class="feature-credit">
              {[lede.sideA, lede.sideB].map(side => (
                <>
                  {side.href ? <a href={side.href}>{side.name}</a> : <span>{side.name}</span>}
                  <span class="issue-dot">&middot;</span>
                </>
              ))}
              <a href={lede.href ?? '/scores'}>{weekIsFinal ? 'Full box score' : 'Matchup detail'}</a>
            </p>
          </section>
        )}

        {slate.length > 0 && (
          <section class:list={{ 'rail-after-feature': lede }}>
            <h2 class="rail-head">{slateIsFixtures ? 'The Opening Slate' : 'Latest Scores'}</h2>
            <p class="rail-stamp slugline">{slateYear} &middot; Week {slateWeek}</p>

            <div class="score-rail">
              {slate.map(g => (
                <a href={g.href ?? '/scores'} class="rail-game">
                  <span class="rail-side">
                    <img src={logoPath(g.a!.abbr)} alt="" width="22" height="22" onerror="this.style.display='none'" />
                    <span class="rail-abbr">{g.a!.abbr}</span>
                    <span class:list={['rail-score', { win: weekIsFinal && !slateIsFixtures && g.scoreA > g.scoreB }]}>
                      {slateIsFixtures ? '' : formatPoints(g.scoreA)}
                    </span>
                  </span>
                  <span class="rail-side">
                    <img src={logoPath(g.b!.abbr)} alt="" width="22" height="22" onerror="this.style.display='none'" />
                    <span class="rail-abbr">{g.b!.abbr}</span>
                    <span class:list={['rail-score', { win: weekIsFinal && !slateIsFixtures && g.scoreB > g.scoreA }]}>
                      {slateIsFixtures ? '' : formatPoints(g.scoreB)}
                    </span>
                  </span>
                </a>
              ))}
            </div>

            <p class="rail-more"><a href="/scores">Every score, every week</a></p>
          </section>
        )}
      </aside>
    )}
  </div>

  <!-- ══ STANDING ORDER + CHAMPIONS ROLL ════════════════════════════════ -->
  <div class="wrap two-up">

    {showSeasonStandings ? (
    <section class="standing">
      <div class="almanac-head">
        <h2>{standingsYear} Standings</h2>
        {standingsThroughWeek && <span class="folio">Through Week {standingsThroughWeek}</span>}
      </div>
      <div class="ledger-scroll">
      <table class="ledger">
        <thead>
          <tr>
            <th class="rank"></th>
            <th>Franchise</th>
            <th class="num">W</th>
            <th class="num">L</th>
            <th class="num">Pct</th>
            <th class="num">PF</th>
            <th class="num col-drop">PA</th>
          </tr>
        </thead>
        {seasonStandings.map(conf => (
          <tbody>
            <tr class="conf-row">
              <th colspan="7" class:list={['conf-name', `conf-${conf.code.toLowerCase()}`]}>{conf.name}</th>
            </tr>
            {conf.rows.map((row, i) => (
              <tr>
                <td class="rank">{i + 1}</td>
                <td class="standing-team">
                  <span class="keel" style={`background-color: ${primaryColor(row.colors)};`}></span>
                  <a href={`/franchises/${row.linkAbbr}`}>{row.name}</a>
                </td>
                <td class="num">{row.w}</td>
                <td class="num">{row.l}</td>
                <td class="num">{row.pct.toFixed(3).replace(/^0/, '')}</td>
                <td class="num">{formatPoints(row.pf)}</td>
                <td class="num col-drop">{formatPoints(row.pa)}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
      </div>
    </section>
    ) : (
    <section class="standing">
      <div class="almanac-head">
        <h2>All-Time Standings</h2>
      </div>
      <div class="ledger-scroll">
      <table class="ledger">
        <thead>
          <tr>
            <th class="rank"></th>
            <th>Franchise</th>
            <th class="col-drop">Owner</th>
            <th class="num">W</th>
            <th class="num">L</th>
            <th class="num">Pct</th>
            <th class="num col-drop">Points For</th>
            <th class="num">Bowls</th>
          </tr>
        </thead>
        <tbody>
          {standingOrder.map((row, i) => (
            <tr>
              <td class="rank">{i + 1}</td>
              <td class="standing-team">
                <span class="keel" style={`background-color: ${primaryColor(row.colors)};`}></span>
                <a href={`/franchises/${row.abbr}`}>{row.name}</a>
                <span class="standing-conf">{row.conf}</span>
              </td>
              <td class="col-drop standing-owner">{row.owner}</td>
              <td class="num">{row.w}</td>
              <td class="num">{row.l}</td>
              <td class="num">{row.pct.toFixed(3).replace(/^0/, '')}</td>
              <td class="num col-drop">{Math.round(row.pf).toLocaleString('en-US')}</td>
              <td class="num bowls">{row.titles > 0 ? '⬢'.repeat(row.titles) : <span class="dash">&middot;</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </section>
    )}

    <section class="roll">
      <div class="almanac-head">
        <h2>Champions</h2>
      </div>
      <ol class="roll-list">
        {championsRoll.map(c => (
          <li class="roll-item">
            <span class="roll-numeral">{c.label}</span>
            <span class="roll-body">
              <img src={logoPath(c.champ?.abbr ?? '')} alt="" width="26" height="26" onerror="this.style.display='none'" />
              <a href={`/franchises/${activeFranchise(franchises, String(c.champ?.sleeper_id ?? ''))?.abbr ?? c.champ?.abbr}`} class="roll-name">{c.champ?.name}</a>
              <span class="roll-detail">
                {c.year} &middot; {formatPoints(c.scoreW)}&ndash;{formatPoints(c.scoreL)} over {c.loser?.abbr}
              </span>
            </span>
          </li>
        ))}
      </ol>
      <p class="rail-more"><a href="/history">Season by season, back to 2021</a></p>
    </section>
  </div>

  <!-- ══ BOWL GAMES — dense index, no cards ════════════════════════════ -->
  {bowlGames.length > 0 && (
    <div class="wrap bowl-section">
      <div class="almanac-head">
        <h2>The Bowl Games of {currentYear}</h2>
      </div>

      <div class="bowl-index">
        {bowlGames.map(g => (
          <a href={`/spotlight-games/${g.slug}`} class="bowl-entry">
            <span class="bowl-logos">
              <img src={logoPath(g.teamA)} alt="" width="24" height="24" onerror="this.style.display='none'" />
              <img src={logoPath(g.teamB)} alt="" width="24" height="24" onerror="this.style.display='none'" />
            </span>
            <span class="bowl-text">
              <span class="bowl-name">{g.name}</span>
              <span class="bowl-meta">
                {g.teamA} v {g.teamB}
                <span class="bowl-since">est. {g.since}</span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- ══ RECORD BOOK — extremes across one horizontal band ══════════════ -->
  {recordBook.length > 0 && (
    <div class="wrap record-section">
      <div class="almanac-head">
        <h2>The Record Book</h2>
      </div>

      <dl class="record-row">
        {recordBook.map(r => (
          <div class="record-cell">
            <dt>{r.label}</dt>
            <dd>
              <a href={r.href ?? '/hall-of-fame/records'} class="record-fig">{r.value}</a>
              <span class="record-line">{r.line}</span>
              <span class="slugline">{r.year} &middot; Week {r.week}</span>
            </dd>
          </div>
        ))}
      </dl>

      <p class="record-more"><a href="/hall-of-fame/records">The complete record book</a></p>
    </div>
  )}

</Layout>

<style>
  /* ── Front page: the lede and the score rail ──────────────────────────────── */
  .front-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 2.5rem;
    padding-top: 2.75rem;
    padding-bottom: 3.5rem;
    align-items: start;
  }

  /* DOM order is lede → score rail, which is also the reading order wanted
     when the grid collapses to one column. */
  .lede      { order: 1; }
  .rail-right{ order: 2; }

  /* An ink panel, not a ruled light column — results belong in the broadcast
     register. `data-theme="ink"` on the element re-scopes the colour tokens,
     so the rules below keep using semantic names and flip with it. */
  .rail-right {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--text-body);
    background-color: var(--ink-900);
    padding: 1.25rem 1.25rem 1.4rem;
  }

  .rail-head {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
    color: var(--text-strong);
    margin: 0 0 0.6rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--rule-ink);
    line-height: 1;
  }

  .rail-more {
    margin: 1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.74rem;
  }

  /* ── The lede ───────────────────────────────────────────────────────── */
  .lede-head {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6.4vw, 4.9rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--text-strong);
    margin: 0 0 1.25rem;
  }
  .lede-head-tail {
    display: block;
    font-size: 0.42em;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  /* The bracket carries its own styles; this only spaces it inside the lede. */
  .lede-bracket { margin: 0 0 1.25rem; }

  /* ── Featured game: the week's headline game, top of the rail ───────── */
  /* The old centre scorebug, restacked for rail width: each side is a row of
     crest(s), label and figure, keeled in its club colour — still
     `primaryColorOnInk()`, since the ground is `--ink-900`. */
  .feature-score {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.75rem;
    text-decoration: none;
  }
  .feature-score:hover { text-decoration: none; }
  .feature-score:hover .feature-side { background-color: rgba(244, 236, 216, 0.06); }

  .feature-side {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.4rem 0.4rem 0.55rem;
    border-left: 4px solid var(--keel, var(--ember-500));
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .feature-crests { display: flex; align-items: center; gap: 0.2rem; }
  .feature-side img { width: 36px; height: 36px; object-fit: contain; }
  /* An exhibition squad carries one crest per member; they share the space
     one club crest would take, so the figures stay in one column. */
  .feature-side.is-squad img { width: calc(44px / var(--n)); height: auto; aspect-ratio: 1; }

  .feature-abbr {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--paper-200);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .is-squad .feature-abbr { font-size: 0.95rem; }

  /* Parchment is the resting state for a figure on ink: a live score is just
     a number, not yet a result. Gold arrives only once the week is final —
     see `weekIsFinal`, which both scorebugs in the rail share. */
  .feature-num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums lining-nums;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--paper-200);
  }
  .feature-num.win { color: var(--gold-400); font-weight: 700; }

  .feature-credit {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.45rem;
    margin: 0;
    font-size: 0.72rem;
  }

  .rail-after-feature { margin-top: 1.5rem; }

  .issue-dot { color: var(--text-muted); }

  .lede-credit {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-default);
  }

  /* ── Score rail ─────────────────────────────────────────────────────── */
  /* The week's remaining games, posted down the column. Each game stacks its
     two sides so the figures form a single right-aligned column the eye can
     run down — a side-by-side scoreline has nowhere to go at rail width. */
  .rail-stamp { display: block; margin: -0.35rem 0 0.9rem; color: var(--text-faint); }

  .score-rail { display: flex; flex-direction: column; }

  .rail-game {
    display: block;
    padding: 0.5rem 0.3rem;
    border-bottom: 1px dotted var(--border-default);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .rail-game:hover { text-decoration: none; background-color: rgba(244, 236, 216, 0.06); }

  .rail-side {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 0.45rem;
    padding: 0.12rem 0;
  }
  .rail-side img { object-fit: contain; }

  .rail-abbr {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--text-strong);
    line-height: 1.1;
  }
  /* Same rule as the lede scorebug: parchment at rest, gold only once the
     week is final. `--paper-200` rather than `--text-body` so the two match
     literally — the lede slab is ink-coloured but carries no `data-theme`. */
  .rail-score {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--paper-200);
  }
  /* Gold is the ink register's winner marker — pine goes muddy on this ground. */
  .rail-score.win { color: var(--gold-400); font-weight: 700; }

  /* ── Two-up: ledger + roll ──────────────────────────────────────────── */
  .two-up {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: 3.5rem;
    padding-top: 3.5rem;
    padding-bottom: 1rem;
    align-items: start;
  }

  .standing-team { display: flex; align-items: center; gap: 0.5rem; }
  .keel { display: inline-block; width: 3px; height: 15px; flex-shrink: 0; }
  .standing-team a { color: var(--text-strong); font-weight: 600; }
  .standing-conf {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-disabled);
    letter-spacing: 0.06em;
  }
  .standing-owner { color: var(--text-faint); font-size: 0.78rem; }
  .ledger .dash { color: var(--text-disabled); }
  .ledger td.bowls { color: var(--gold-700); letter-spacing: 0.08em; }

  /* Conference sub-heads inside the season ledger — a band of the table, not
     a separate box, so the two conferences read as one standings page. */
  .ledger tbody + tbody .conf-row th { padding-top: 1.4rem; }
  .ledger .conf-name {
    text-align: left;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule-ink);
  }
  .ledger .conf-scc { color: var(--slate-600); }
  .ledger .conf-hcc { color: var(--ember-600); }

  .roll-list { list-style: none; margin: 0; padding: 0; }
  .roll-item {
    display: flex;
    gap: 0.85rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px dotted var(--border-default);
  }
  .roll-numeral {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--gold-600);
    min-width: 2.1rem;
    flex-shrink: 0;
  }
  .roll-body { display: flex; align-items: center; flex-wrap: wrap; gap: 0.45rem; min-width: 0; }
  .roll-body img { object-fit: contain; flex-shrink: 0; }
  .roll-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-strong);
    line-height: 1.1;
  }
  .roll-detail {
    flex-basis: 100%;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }

  /* ── Bowl games index ───────────────────────────────────────────────── */
  .bowl-section { padding-top: 3.5rem; padding-bottom: 2rem; }
  .bowl-index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 0 2.25rem;
  }
  .bowl-entry {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px dotted var(--border-default);
    text-decoration: none;
  }
  .bowl-entry:hover { text-decoration: none; }
  .bowl-entry:hover .bowl-name { color: var(--ember-700); }
  .bowl-logos { display: flex; gap: 0.15rem; flex-shrink: 0; }
  .bowl-logos img { object-fit: contain; }
  .bowl-text { display: flex; flex-direction: column; min-width: 0; }
  .bowl-name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-strong);
    transition: var(--transition-color);
  }
  .bowl-meta {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
    display: flex;
    gap: 0.5rem;
  }
  .bowl-since { color: var(--text-disabled); }

  /* ── Record book: one horizontal band of extremes ───────────────────── */
  .record-section { padding-top: 2.5rem; padding-bottom: 3.5rem; }

  .record-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 0;
  }
  /* A rule over each figure rather than a box around it — the columns read as
     one band of the same kind of fact, which four bordered tiles would not. */
  .record-cell {
    padding-top: 0.7rem;
    min-width: 0;
  }
  .record-cell dt {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .record-cell dd { margin: 0.25rem 0 0; display: flex; flex-direction: column; }

  .record-fig {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    line-height: 1.05;
  }
  .record-fig:hover { color: var(--ember-700); text-decoration: none; }
  .record-line { font-size: 0.8rem; color: var(--text-muted); line-height: 1.35; margin-top: 0.2rem; }

  .record-more {
    margin: 1.1rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border-default);
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1080px) {
    /* Four record columns get too narrow for a 1.75rem figure plus a club
       name; two rows of two hold the measure. */
    .record-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 2.5rem; }
    .two-up { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
  }

  .ledger-scroll { overflow-x: auto; }

  @media (max-width: 760px) {
    /* One column, DOM order: the lede, then the rest of the week beneath it. */
    .front-page { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .lede, .rail-right { order: 0; }
    /* Full width is wasted on a stacked scoreline, so the games run two-up. */
    .score-rail { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.75rem; }
    .col-drop { display: none; }
  }

  @media (max-width: 520px) {
    .record-row { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .score-rail { grid-template-columns: 1fr; }
  }
</style>

---
import '../styles/global.css';
import { toRoman } from '../lib/format';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Official archive of the Sixth City Dynasty Fantasy Football League. Est. 2021.',
} = Astro.props;
const pageTitle = title === 'SCDFL' ? title : `${title} — SCDFL`;

// League year runs March → February, so a January Dynasty Bowl still belongs to
// the previous autumn's season. Derived rather than queried: the masthead is
// also rendered by the on-demand player route, where a DB round-trip would be
// latency on every pageview.
const now = new Date();
const leagueYear =
  now.getUTCMonth() >= 2 ? now.getUTCFullYear() : now.getUTCFullYear() - 1;
const volume = toRoman(leagueYear - 2020);

const navLinks = [
  { href: '/history', label: 'History' },
  { href: '/franchises', label: 'Franchises' },
  { href: '/scores', label: 'Scores' },
  { href: '/spotlight-games', label: 'Spotlight' },
  { href: '/content', label: 'Content' },
  { href: '/bets', label: 'Bets' },
  { href: '/hall-of-fame', label: 'Hall of Fame' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4ECD8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css"
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="masthead">
      <div class="sc-stripe masthead-stripe" aria-hidden="true"></div>

      <!-- Masthead proper: scrolls away. The nameplate is flanked by the
           publication data an almanac carries on its cover. -->
      <div class="masthead-plate">
        <p class="plate-dateline plate-left">
          Established 2021<br />Cleveland, Ohio
        </p>

        <a href="/" class="plate-name">
          <img
            src="/brand/emblem.svg"
            width="34"
            height="34"
            alt=""
            class="plate-emblem"
          />
          <span class="plate-word">Sixth City</span>
        </a>

        <p class="plate-dateline plate-right">
          Volume {volume}<br />Fourteen Clubs
        </p>
      </div>

      <p class="plate-sub">
        Dynasty Football League &middot; A Record of Play Since MMXXI
      </p>

      <!-- Section rail: sticks. Set in the display face rather than as
           uppercase micro-labels, and ruled instead of boxed. -->
      <nav class="section-rail" id="main-nav">
        <button
          id="hamburger-btn"
          aria-label="Toggle navigation"
          aria-expanded="false">
          <span class="hamburger-word">Sections</span>
          <span class="hamburger-bars"
            ><span></span><span></span><span></span></span
          >
        </button>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'rail-link',
                    { 'is-active': isActive(link.href) },
                  ]}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Colophon: the back matter of a printed annual, not a nav footer. -->
    <footer class="colophon">
      <div class="sc-stripe colophon-stripe" aria-hidden="true"></div>
      <div class="colophon-inner">
        <div class="colophon-brand">
          <img src="/brand/emblem.svg" width="30" height="30" alt="" />
          <div>
            <p class="colophon-title">Sixth City Dynasty Football League</p>
            <p class="colophon-line">
              Fourteen franchises. Four months. A lifetime of fellowship. Rugged Cleveland football in the Great White North.
            </p>
            <p class="colophon-rights">
              Copyright © Zacalytics &middot; Some rights reserved.
            </p>
          </div>
        </div>

        <div class="colophon-index">
          <p class="colophon-head">Index</p>
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  main {
    flex: 1;
  }

  /* ============ MASTHEAD ============ */
  .masthead {
    background-color: var(--surface-page);
    position: relative;
    z-index: 50;
  }

  .masthead-stripe {
    height: 5px;
    width: 100%;
  }

  .masthead-plate {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0.4rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .plate-dateline {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0;
  }
  .plate-left {
    text-align: left;
  }
  .plate-right {
    text-align: right;
  }

  .plate-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-strong);
    white-space: nowrap;
  }
  .plate-name:hover {
    text-decoration: none;
    color: var(--text-strong);
  }

  .plate-emblem {
    display: block;
    flex-shrink: 0;
  }

  .plate-word {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .plate-sub {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 0.9rem;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  /* ---- Section rail (sticky) ---- */
  .section-rail {
    position: sticky;
    top: 0;
    z-index: 60;
    background-color: var(--surface-page);
    border-top: 2px solid var(--rule-ink);
    border-bottom: 1px solid var(--rule-ink);
  }

  .section-rail ul {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0;
    list-style: none;
  }

  .rail-link {
    display: block;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0.42rem 1.05rem;
    border-bottom: 3px solid transparent;
    transition: var(--transition-color);
  }
  .section-rail li + li .rail-link {
    box-shadow: -1px 0 0 var(--border-hairline);
  }

  .rail-link:hover {
    color: var(--text-strong);
    text-decoration: none;
    background-color: var(--surface-sunken);
  }

  .rail-link.is-active {
    color: var(--ember-700);
    border-bottom-color: var(--ember-500);
  }

  /* ---- Hamburger (mobile only) ---- */
  #hamburger-btn {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.6rem 1.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-strong);
  }
  .hamburger-bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hamburger-bars span {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--text-strong);
  }

  /* ============ COLOPHON ============ */
  .colophon {
    margin-top: 6rem;
    background-color: var(--surface-sunken);
    border-top: 2px solid var(--rule-ink);
  }
  .colophon-stripe {
    height: 4px;
    width: 100%;
  }

  .colophon-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: 2.9fr 1.5fr;
    gap: 3rem;
    align-items: start;
  }

  .colophon-brand {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .colophon-brand img {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .colophon-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: var(--text-strong);
    margin: 0 0 0.4rem;
    line-height: 1;
  }

  .colophon-line {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
    max-width: 42ch;
  }

  .colophon-head {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 0.7rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border-default);
  }

  .colophon-index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 1.25rem;
  }
  .colophon-index li {
    margin-bottom: 0.3rem;
    break-inside: avoid;
  }
  .colophon-index a {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-body);
  }

  .colophon-rights {
    color: var(--text-faint) !important;
    font-size: 0.7rem !important;
  }

  /* ============ MOBILE ============ */
  @media (max-width: 860px) {
    .masthead-plate {
      grid-template-columns: 1fr;
      justify-items: center;
      padding: 1.1rem 1.5rem 0.3rem;
      gap: 0.5rem;
    }
    .plate-left,
    .plate-right {
      display: none;
    }
    .plate-sub {
      font-size: 0.72rem;
      padding-bottom: 0.7rem;
    }

    #hamburger-btn {
      display: flex;
    }

    .section-rail ul {
      display: none;
      flex-direction: column;
      padding: 0 0 0.5rem;
      background-color: var(--surface-page);
      border-top: 1px solid var(--border-default);
    }
    .section-rail.open ul {
      display: flex;
    }
    .rail-link {
      padding: 0.7rem 1.5rem;
      border-bottom: 1px solid var(--border-hairline);
      border-left: 3px solid transparent;
    }
    .section-rail li + li .rail-link {
      box-shadow: none;
    }
    .rail-link.is-active {
      border-bottom-color: var(--border-hairline);
      border-left-color: var(--ember-500);
    }

    .colophon-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const nav = document.getElementById('main-nav');

  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>

---
import { logoPath } from '../lib/format';
import type { BracketMatchup, BracketTeam } from '../lib/playoff-bracket';

/**
 * One matchup in `PlayoffBracket` — two stacked team slots, or one for a bye.
 *
 * Every filled slot carries `data-seed` and the `.slot-logo` / `.slot-seed` /
 * `.slot-name` children, so `/sim` can re-seat teams in place as the seeding
 * changes. Keep that contract if the markup changes.
 *
 * `fillable` (for `/sim`) also renders those children in *empty* slots,
 * hidden, and stamps each slot `data-slot="{id}-top|bottom"`: a script can
 * then fill a later round without creating elements, which would miss this
 * component's scoped styles.
 */
interface Props {
  matchup: BracketMatchup;
  semi?: boolean;
  /** Slot id prefix, e.g. `r1lb` — see PLAYOFF_PICK_KEYS */
  id?: string;
  fillable?: boolean;
}

const { matchup, semi = false, id, fillable = false } = Astro.props;
const slots: { team: BracketTeam | null; pos: 'top' | 'bottom' }[] = matchup.bye
  ? [{ team: matchup.top, pos: 'top' }]
  : [{ team: matchup.top, pos: 'top' }, { team: matchup.bottom, pos: 'bottom' }];
const Wrapper = matchup.href ? 'a' : 'div';
---

<Wrapper href={matchup.href ?? undefined} class:list={['bracket-matchup', { 'bracket-matchup-link': matchup.href }]}>
  {slots.map(({ team, pos }, i) => (
    <>
      {i > 0 && <div class="bracket-connector-v"></div>}
      <div
        class:list={['bracket-slot', pos, { 'semi-slot': semi, 'bye-slot': matchup.bye, 'is-empty': !team }]}
        data-seed={team?.seed}
        data-slot={id ? `${id}-${pos}` : undefined}
      >
        {(team || fillable) && (
          <>
            <img class="slot-logo" src={team ? logoPath(team.abbr) : undefined} alt="" width="20" height="20" hidden={!team} onerror="this.style.display='none'" />
            <span class="slot-seed" hidden={!team}>{team?.seed}</span>
            <span class="slot-name" hidden={!team}>{team?.abbr}</span>
          </>
        )}
        {matchup.bye && <span class="bye-label">BYE</span>}
      </div>
    </>
  ))}
</Wrapper>

<style>
  .bracket-matchup {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    position: relative;
  }

  .bracket-matchup-link {
    cursor: pointer;
    text-decoration: none;
  }

  /* Connector line between two slots in a matchup */
  .bracket-connector-v {
    width: 100%;
    height: 2px;
    background-color: var(--color-border);
    margin: 0;
    position: relative;
  }

  /* Vertical bar on the right side for left-bracket slots */
  .bracket-connector-v::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -1.25rem;
    border-right: 2px solid var(--color-border);
    height: 2.5rem;
  }

  /* Vertical bar on the left side for right-bracket slots */
  :global(.bracket-right) .bracket-connector-v::after {
    left: -1px;
    right: auto;
    border-right: none;
    border-left: 2px solid var(--color-border);
  }

  .bracket-slot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.6rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    min-width: 110px;
    height: 2.5rem;
    font-size: 0.8rem;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  :global(.bracket-right) .bracket-slot {
    flex-direction: row-reverse;
    text-align: right;
  }

  .bracket-slot img {
    object-fit: contain;
    flex-shrink: 0;
  }

  .slot-seed {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text-muted);
    min-width: 14px;
    text-align: center;
  }

  .slot-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8rem;
  }

  /* Semi-round slots have a solid border when populated, dashed when empty */
  .semi-slot {
    min-width: 90px;
  }

  .semi-slot.is-empty {
    background-color: color-mix(in srgb, var(--color-surface) 60%, transparent);
    border-style: dashed;
    color: var(--color-text-muted);
  }

  .bye-slot {
    border-color: var(--color-gold-dim);
  }

  /* /sim: a slot the reader can click to advance, and the result once they do.
     A pick is a result, so the winner takes pine as it does in the schedule. */
  .bracket-slot.is-pickable { cursor: pointer; transition: var(--transition-color); }
  .bracket-slot.is-pickable:hover,
  .bracket-slot.is-pickable:focus-visible {
    border-color: var(--rule-ink);
    background-color: var(--surface-sunken);
    outline: none;
  }
  .bracket-slot.is-winner {
    border-color: var(--status-win);
    background-color: var(--pine-100);
  }
  .bracket-slot.is-winner .slot-name { color: var(--pine-700); }
  .bracket-slot.is-loser { opacity: 0.45; }

  .bye-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-gold-dim);
    margin-left: auto;
  }
</style>
